load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_applicable_licenses = ["@heir//:license"],
    default_visibility = ["//visibility:public"],
)

# Suite-level shared code: workload hooks (bench_hooks::*) and reference
# implementation (compute_bits_col_major + reference_onehot). Every
# argmax bench binary depends on this.
cc_library(
    name = "hooks",
    hdrs = [
        "bench_hooks.h",
        "reference.h",
    ],
    includes = ["."],
    deps = [
        "//biscotti-bench/benchmarks/common:types",
    ],
)

# One cc_binary per (kernel, size, variant). Variants:
#   ""          — hoisted / coyote-optimized (default from build.sh)
#   "_baseline" — biscotti inline=-1, fully unrolled (build.sh --baseline)
#
# The recursive-argmax MLIR is generated by benchmarks/argmax/gen_argmax.py.
# Kernel input is the NxN column-major pairwise-bit matrix (encrypted).
# Recursion splits columns into disjoint halves; base case k=2 does an
# element-wise mul of two columns (length-N tensor result).  Powers of 2
# recurse cleanly; the ladder is dense at the low end to test odd
# column-count splits.
[
    cc_binary(
        name = "bench_" + kernel + variant,
        srcs = [
            "output/" + kernel + variant + "/benchmark.cpp",
            "output/" + kernel + variant + "/kernel.cpp",
            "output/" + kernel + variant + "/kernel.h",
        ],
        copts = [
            "-DBENCH_HOOKS_SIZE=" + size,
            "-Wno-c++11-narrowing",
        ],
        includes = ["output/" + kernel + variant],
        deps = [
            ":hooks",
            "//biscotti-bench/benchmarks/common:types",
            "@google_benchmark//:benchmark_main",
            "@openfhe//:core",
            "@openfhe//:pke",
        ],
    )
    for kernel, size in [
        ("argmax_4", "4"),
        ("argmax_5", "5"),
        ("argmax_6", "6"),
        ("argmax_7", "7"),
        ("argmax_8", "8"),
        ("argmax_16", "16"),
        ("argmax_32", "32"),
        ("argmax_64", "64"),
        ("argmax_128", "128"),
        ("argmax_256", "256"),
    ]
    for variant in [
        "",
        "_baseline",
    ]
]
