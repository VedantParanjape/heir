load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_applicable_licenses = ["@heir//:license"],
    default_visibility = ["//visibility:public"],
)

# Suite-level shared code: workload hooks (bench_hooks::*) and the plaintext
# determinant reference (det_bench::*). Every det bench binary depends on it.
cc_library(
    name = "hooks",
    hdrs = [
        "bench_hooks.h",
        "reference.h",
    ],
    includes = ["."],
    deps = [
        "//biscotti-bench/benchmarks/common:types",
    ],
)

# One cc_binary per (kernel, size, variant). Variants:
#   ""                  — hoisted / coyote-optimized (default from build.sh)
#   "_baseline"         — biscotti inline=-1, fully unrolled (--baseline)
#   "_baseline_vanilla" — vanilla upstream Coyote, unrolled (--baseline-vanilla)
#
# The recursive-determinant MLIR is generated by benchmarks/det/gen_det.py.
# Kernel input is the flattened row-major N*N matrix (encrypted). Cofactor
# expansion along row 0 recurses on (n-1)x(n-1) minors down to a 2x2 base.
[
    cc_binary(
        name = "bench_" + kernel + variant,
        srcs = [
            "output/" + kernel + variant + "/benchmark.cpp",
            "output/" + kernel + variant + "/kernel.cpp",
            "output/" + kernel + variant + "/kernel.h",
        ],
        copts = [
            "-DBENCH_HOOKS_SIZE=" + size,
            "-Wno-c++11-narrowing",
        ],
        includes = ["output/" + kernel + variant],
        deps = [
            ":hooks",
            "//biscotti-bench/benchmarks/common:types",
            "@google_benchmark//:benchmark_main",
            "@openfhe//:core",
            "@openfhe//:pke",
        ],
    )
    for kernel, size in [
        ("det_3", "3"),
        ("det_4", "4"),
        ("det_5", "5"),
    ]
    for variant in [
        "",
        "_baseline",
        "_baseline_vanilla",
    ]
]
