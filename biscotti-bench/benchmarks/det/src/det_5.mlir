// Recursive determinant of an N=5 matrix via cofactor expansion
// along row 0. Input: flattened row-major N*N = 25 matrix
// (encrypted). Output: length-1 tensor holding det.
//
// Generated by benchmarks/det/gen_det.py -- do not hand-edit.

!val = i32
!svec = !secret.secret<tensor<?x!val>>   // one dynamic type: matrix, minor, and det result
!cff  = !secret.secret<!val>             // scalar cofactor coefficient

func.func @det(
    %mat : !svec,
    %n   : !val { biscotti.progress_argument = 1 }
) -> !svec {
    %c2v      = arith.constant 2 : !val
    %one_val  = arith.constant 1 : !val
    %zero_val = arith.constant 0 : !val

    %cond = arith.cmpi sle, %n, %c2v : !val
    cf.cond_br %cond, ^base, ^recursive { biscotti.base_condition = 0 }

^base:
    // n == 2: det = m[0]*m[3] - m[1]*m[2]  (row-major 2x2).
    %rb = secret.generic(%mat : !svec) {
        ^bb0(%m: tensor<?x!val>):
            %i0 = arith.constant 0 : index
            %i1 = arith.constant 1 : index
            %i2 = arith.constant 2 : index
            %i3 = arith.constant 3 : index
            %a = tensor.extract %m[%i0] : tensor<?x!val>
            %b = tensor.extract %m[%i1] : tensor<?x!val>
            %c = tensor.extract %m[%i2] : tensor<?x!val>
            %d = tensor.extract %m[%i3] : tensor<?x!val>
            %ad = arith.muli %a, %d : !val
            %bc = arith.muli %b, %c : !val
            %det = arith.subi %ad, %bc : !val
            %out = tensor.from_elements %det : tensor<1x!val>
            %out_cast = tensor.cast %out : tensor<1x!val> to tensor<?x!val>
            secret.yield %out_cast : tensor<?x!val>
    } -> (!svec)
    return %rb : !svec

^recursive:
    // n > 2: cofactor expansion along row 0 -> N minors, each recursed.
    // det = sum_j (-1)^j * a_j * det(minor_j), a_j = A[0][j]. Minors are
    // pure extraction; a_j*sub_j is done in the reduction.
    %one_idx  = arith.constant 1 : index
    %nm1      = arith.subi %n, %one_val : !val
    %nm1_idx  = arith.index_cast %nm1 : !val to index
    %n_idx    = arith.index_cast %n : !val to index
    %nm1sq    = arith.muli %nm1, %nm1 : !val
    %nm1sq_idx = arith.index_cast %nm1sq : !val to index

    %cj0 = arith.constant 0 : !val
    %mask0 = arith.cmpi slt, %cj0, %n : !val   // in-range gate (1 if j<n)
    %maskv0 = arith.select %mask0, %one_val, %zero_val : !val
    %cj1 = arith.constant 1 : !val
    %mask1 = arith.cmpi slt, %cj1, %n : !val   // in-range gate (1 if j<n)
    %maskv1 = arith.select %mask1, %one_val, %zero_val : !val
    %cj2 = arith.constant 2 : !val
    %mask2 = arith.cmpi slt, %cj2, %n : !val   // in-range gate (1 if j<n)
    %maskv2 = arith.select %mask2, %one_val, %zero_val : !val
    %cj3 = arith.constant 3 : !val
    %mask3 = arith.cmpi slt, %cj3, %n : !val   // in-range gate (1 if j<n)
    %maskv3 = arith.select %mask3, %one_val, %zero_val : !val
    %cj4 = arith.constant 4 : !val
    %mask4 = arith.cmpi slt, %cj4, %n : !val   // in-range gate (1 if j<n)
    %maskv4 = arith.select %mask4, %one_val, %zero_val : !val
    // Cofactor coefficients a_j = A[0][j] = mat[j] (masked when need_mask).
    %a0, %a1, %a2, %a3, %a4 = secret.generic(%mat : !svec, %maskv0 : !val, %maskv1 : !val, %maskv2 : !val, %maskv3 : !val, %maskv4 : !val) {
    ^bb0(%cm: tensor<?x!val>, %mvb0: !val, %mvb1: !val, %mvb2: !val, %mvb3: !val, %mvb4: !val):
        %ce0 = arith.constant 0 : index
        %cv0 = tensor.extract %cm[%ce0] : tensor<?x!val>
        %cvm0 = arith.muli %cv0, %mvb0 : !val   // in-range mask
        %ce1 = arith.constant 1 : index
        %cv1 = tensor.extract %cm[%ce1] : tensor<?x!val>
        %cvm1 = arith.muli %cv1, %mvb1 : !val   // in-range mask
        %ce2 = arith.constant 2 : index
        %cv2 = tensor.extract %cm[%ce2] : tensor<?x!val>
        %cvm2 = arith.muli %cv2, %mvb2 : !val   // in-range mask
        %ce3 = arith.constant 3 : index
        %cv3 = tensor.extract %cm[%ce3] : tensor<?x!val>
        %cvm3 = arith.muli %cv3, %mvb3 : !val   // in-range mask
        %ce4 = arith.constant 4 : index
        %cv4 = tensor.extract %cm[%ce4] : tensor<?x!val>
        %cvm4 = arith.muli %cv4, %mvb4 : !val   // in-range mask
        secret.yield %cvm0, %cvm1, %cvm2, %cvm3, %cvm4 : !val, !val, !val, !val, !val
    } -> (!cff, !cff, !cff, !cff, !cff)

    // ---- cofactor minor j=0: drop row 0, column 0 (pure extraction) ----
    %jc0_idx = arith.constant 0 : index
    %minor0 = secret.generic(%mat : !svec, %nm1_idx : index, %n_idx : index, %jc0_idx : index, %nm1sq_idx : index) {
    ^bb0(%m0: tensor<?x!val>, %nm1b0: index, %nb0: index, %jcb0: index, %nm1sqb0: index):
      %out0 = tensor.generate %nm1sqb0 {
      ^bb0(%i0: index):
        %rp0 = arith.divsi %i0, %nm1b0 : index                // minor row r'
        %cp0 = arith.remsi %i0, %nm1b0 : index                // minor col c'
        %rp10 = arith.addi %rp0, %one_idx : index               // r'+1 (skip row 0)
        %rowoff0 = arith.muli %rp10, %nb0 : index             // (r'+1)*n
        %ge0 = arith.cmpi sge, %cp0, %jcb0 : index            // c' >= jc ?
        %gez0 = arith.extui %ge0 : i1 to i64                    // 0/1 (unsigned!)
        %skip0 = arith.index_cast %gez0 : i64 to index
        %cpp0 = arith.addi %cp0, %skip0 : index               // c' + (c'>=jc)
        %src0 = arith.addi %rowoff0, %cpp0 : index
        %v0 = tensor.extract %m0[%src0] : tensor<?x!val>
        tensor.yield %v0 : !val
      } : tensor<?x!val>
      secret.yield %out0 : tensor<?x!val>
    } -> (!svec)
    // ---- cofactor minor j=1: drop row 0, column 1 (pure extraction) ----
    %jc1_idx = arith.constant 1 : index
    %minor1 = secret.generic(%mat : !svec, %nm1_idx : index, %n_idx : index, %jc1_idx : index, %nm1sq_idx : index) {
    ^bb0(%m1: tensor<?x!val>, %nm1b1: index, %nb1: index, %jcb1: index, %nm1sqb1: index):
      %out1 = tensor.generate %nm1sqb1 {
      ^bb0(%i1: index):
        %rp1 = arith.divsi %i1, %nm1b1 : index                // minor row r'
        %cp1 = arith.remsi %i1, %nm1b1 : index                // minor col c'
        %rp11 = arith.addi %rp1, %one_idx : index               // r'+1 (skip row 0)
        %rowoff1 = arith.muli %rp11, %nb1 : index             // (r'+1)*n
        %ge1 = arith.cmpi sge, %cp1, %jcb1 : index            // c' >= jc ?
        %gez1 = arith.extui %ge1 : i1 to i64                    // 0/1 (unsigned!)
        %skip1 = arith.index_cast %gez1 : i64 to index
        %cpp1 = arith.addi %cp1, %skip1 : index               // c' + (c'>=jc)
        %src1 = arith.addi %rowoff1, %cpp1 : index
        %v1 = tensor.extract %m1[%src1] : tensor<?x!val>
        tensor.yield %v1 : !val
      } : tensor<?x!val>
      secret.yield %out1 : tensor<?x!val>
    } -> (!svec)
    // ---- cofactor minor j=2: drop row 0, column 2 (pure extraction) ----
    %jc2_idx = arith.constant 2 : index
    %minor2 = secret.generic(%mat : !svec, %nm1_idx : index, %n_idx : index, %jc2_idx : index, %nm1sq_idx : index) {
    ^bb0(%m2: tensor<?x!val>, %nm1b2: index, %nb2: index, %jcb2: index, %nm1sqb2: index):
      %out2 = tensor.generate %nm1sqb2 {
      ^bb0(%i2: index):
        %rp2 = arith.divsi %i2, %nm1b2 : index                // minor row r'
        %cp2 = arith.remsi %i2, %nm1b2 : index                // minor col c'
        %rp12 = arith.addi %rp2, %one_idx : index               // r'+1 (skip row 0)
        %rowoff2 = arith.muli %rp12, %nb2 : index             // (r'+1)*n
        %ge2 = arith.cmpi sge, %cp2, %jcb2 : index            // c' >= jc ?
        %gez2 = arith.extui %ge2 : i1 to i64                    // 0/1 (unsigned!)
        %skip2 = arith.index_cast %gez2 : i64 to index
        %cpp2 = arith.addi %cp2, %skip2 : index               // c' + (c'>=jc)
        %src2 = arith.addi %rowoff2, %cpp2 : index
        %v2 = tensor.extract %m2[%src2] : tensor<?x!val>
        tensor.yield %v2 : !val
      } : tensor<?x!val>
      secret.yield %out2 : tensor<?x!val>
    } -> (!svec)
    // ---- cofactor minor j=3: drop row 0, column 3 (pure extraction) ----
    %jc3_idx = arith.constant 3 : index
    %minor3 = secret.generic(%mat : !svec, %nm1_idx : index, %n_idx : index, %jc3_idx : index, %nm1sq_idx : index) {
    ^bb0(%m3: tensor<?x!val>, %nm1b3: index, %nb3: index, %jcb3: index, %nm1sqb3: index):
      %out3 = tensor.generate %nm1sqb3 {
      ^bb0(%i3: index):
        %rp3 = arith.divsi %i3, %nm1b3 : index                // minor row r'
        %cp3 = arith.remsi %i3, %nm1b3 : index                // minor col c'
        %rp13 = arith.addi %rp3, %one_idx : index               // r'+1 (skip row 0)
        %rowoff3 = arith.muli %rp13, %nb3 : index             // (r'+1)*n
        %ge3 = arith.cmpi sge, %cp3, %jcb3 : index            // c' >= jc ?
        %gez3 = arith.extui %ge3 : i1 to i64                    // 0/1 (unsigned!)
        %skip3 = arith.index_cast %gez3 : i64 to index
        %cpp3 = arith.addi %cp3, %skip3 : index               // c' + (c'>=jc)
        %src3 = arith.addi %rowoff3, %cpp3 : index
        %v3 = tensor.extract %m3[%src3] : tensor<?x!val>
        tensor.yield %v3 : !val
      } : tensor<?x!val>
      secret.yield %out3 : tensor<?x!val>
    } -> (!svec)
    // ---- cofactor minor j=4: drop row 0, column 4 (pure extraction) ----
    %jc4_idx = arith.constant 4 : index
    %minor4 = secret.generic(%mat : !svec, %nm1_idx : index, %n_idx : index, %jc4_idx : index, %nm1sq_idx : index) {
    ^bb0(%m4: tensor<?x!val>, %nm1b4: index, %nb4: index, %jcb4: index, %nm1sqb4: index):
      %out4 = tensor.generate %nm1sqb4 {
      ^bb0(%i4: index):
        %rp4 = arith.divsi %i4, %nm1b4 : index                // minor row r'
        %cp4 = arith.remsi %i4, %nm1b4 : index                // minor col c'
        %rp14 = arith.addi %rp4, %one_idx : index               // r'+1 (skip row 0)
        %rowoff4 = arith.muli %rp14, %nb4 : index             // (r'+1)*n
        %ge4 = arith.cmpi sge, %cp4, %jcb4 : index            // c' >= jc ?
        %gez4 = arith.extui %ge4 : i1 to i64                    // 0/1 (unsigned!)
        %skip4 = arith.index_cast %gez4 : i64 to index
        %cpp4 = arith.addi %cp4, %skip4 : index               // c' + (c'>=jc)
        %src4 = arith.addi %rowoff4, %cpp4 : index
        %v4 = tensor.extract %m4[%src4] : tensor<?x!val>
        tensor.yield %v4 : !val
      } : tensor<?x!val>
      secret.yield %out4 : tensor<?x!val>
    } -> (!svec)
    %sub0 = call @det(%minor0, %nm1) { biscotti.recursive_call = 0 } : (!svec, !val) -> !svec
    %sub1 = call @det(%minor1, %nm1) { biscotti.recursive_call = 1 } : (!svec, !val) -> !svec
    %sub2 = call @det(%minor2, %nm1) { biscotti.recursive_call = 2 } : (!svec, !val) -> !svec
    %sub3 = call @det(%minor3, %nm1) { biscotti.recursive_call = 3 } : (!svec, !val) -> !svec
    %sub4 = call @det(%minor4, %nm1) { biscotti.recursive_call = 4 } : (!svec, !val) -> !svec

    // Single reduction after ALL recursive calls: t_j = a_j * sub_j, then
    // the alternating cofactor sum (subi odd, addi even). Coeffs are raw.
    //   det = +t0 -t1 +t2 -t3 +t4
    %result = secret.generic(%a0 : !cff, %a1 : !cff, %a2 : !cff, %a3 : !cff, %a4 : !cff, %sub0 : !svec, %sub1 : !svec, %sub2 : !svec, %sub3 : !svec, %sub4 : !svec) {
    ^bb0(%aa0: !val, %aa1: !val, %aa2: !val, %aa3: !val, %aa4: !val, %s0: tensor<?x!val>, %s1: tensor<?x!val>, %s2: tensor<?x!val>, %s3: tensor<?x!val>, %s4: tensor<?x!val>):
        %rzero = arith.constant 0 : index
        %sv0 = tensor.extract %s0[%rzero] : tensor<?x!val>
        %ad0 = arith.muli %aa0, %sv0 : !val
        %sv1 = tensor.extract %s1[%rzero] : tensor<?x!val>
        %ad1 = arith.muli %aa1, %sv1 : !val
        %sv2 = tensor.extract %s2[%rzero] : tensor<?x!val>
        %ad2 = arith.muli %aa2, %sv2 : !val
        %sv3 = tensor.extract %s3[%rzero] : tensor<?x!val>
        %ad3 = arith.muli %aa3, %sv3 : !val
        %sv4 = tensor.extract %s4[%rzero] : tensor<?x!val>
        %ad4 = arith.muli %aa4, %sv4 : !val
        %acc1 = arith.subi %ad0, %ad1 : !val
        %acc2 = arith.addi %acc1, %ad2 : !val
        %acc3 = arith.subi %acc2, %ad3 : !val
        %dets = arith.addi %acc3, %ad4 : !val
        %dett = tensor.from_elements %dets : tensor<1x!val>
        %detv = tensor.cast %dett : tensor<1x!val> to tensor<?x!val>
        secret.yield %detv : tensor<?x!val>
    } -> (!svec)
    return %result : !svec
}

// Entry: flattened row-major N*N matrix -> scalar det (static length-1).
!inputvec  = !secret.secret<tensor<25x!val>>
!outputvec = !secret.secret<tensor<1x!val>>

func.func @main(%flat : !inputvec) -> !outputvec {
    %ck = arith.constant 5 : !val

    %mat_dyn = secret.generic(%flat : !inputvec) {
    ^bb0(%f: tensor<25x!val>):
        %cast = tensor.cast %f : tensor<25x!val> to tensor<?x!val>
        secret.yield %cast : tensor<?x!val>
    } -> !svec

    %det_dyn = call @det(%mat_dyn, %ck)
        { biscotti.call = 0 } : (!svec, !val) -> !svec

    // Cast the dynamic det result back to a static length-1 output
    // (matches dot: @det returns !svec dynamic, main returns static).
    %det_val = secret.generic(%det_dyn : !svec) {
    ^bb0(%r: tensor<?x!val>):
        %cast = tensor.cast %r : tensor<?x!val> to tensor<1x!val>
        secret.yield %cast : tensor<1x!val>
    } -> !outputvec

    return %det_val : !outputvec
}
