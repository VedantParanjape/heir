// Flat (non-recursive) 3x3 convolution — base case for the recursive
// conv template. Applies a secret 3x3 filter to a secret 3x3 image
// producing 1 output scalar. Both inputs encrypted; 9 ct-ct muls +
// 8 adds. Emitted here because the recursive template's @conv would
// have nothing to unroll at n=3, which trips a cleanup assertion in
// RecursiveCallVectorization.
//
// Generated by benchmarks/conv/gen_conv.py — do not hand-edit.

!inputvec   = !secret.secret<tensor<9xi32>>
!filterinput = !secret.secret<tensor<9xi32>>
!outputvec  = !secret.secret<tensor<1xi32>>

func.func @main(%img : !inputvec, %filter : !filterinput) -> !outputvec {
    %result = secret.generic(%img : !inputvec, %filter : !filterinput) {
    ^body(%im: tensor<9xi32>, %f: tensor<9xi32>):
        %c0 = arith.constant 0 : index
        %c1 = arith.constant 1 : index
        %c2 = arith.constant 2 : index
        %c3 = arith.constant 3 : index
        %c4 = arith.constant 4 : index
        %c5 = arith.constant 5 : index
        %c6 = arith.constant 6 : index
        %c7 = arith.constant 7 : index
        %c8 = arith.constant 8 : index
        %p0 = tensor.extract %im[%c0] : tensor<9xi32>
        %p1 = tensor.extract %im[%c1] : tensor<9xi32>
        %p2 = tensor.extract %im[%c2] : tensor<9xi32>
        %p3 = tensor.extract %im[%c3] : tensor<9xi32>
        %p4 = tensor.extract %im[%c4] : tensor<9xi32>
        %p5 = tensor.extract %im[%c5] : tensor<9xi32>
        %p6 = tensor.extract %im[%c6] : tensor<9xi32>
        %p7 = tensor.extract %im[%c7] : tensor<9xi32>
        %p8 = tensor.extract %im[%c8] : tensor<9xi32>

        %f0 = tensor.extract %f[%c0] : tensor<9xi32>
        %f1 = tensor.extract %f[%c1] : tensor<9xi32>
        %f2 = tensor.extract %f[%c2] : tensor<9xi32>
        %f3 = tensor.extract %f[%c3] : tensor<9xi32>
        %f4 = tensor.extract %f[%c4] : tensor<9xi32>
        %f5 = tensor.extract %f[%c5] : tensor<9xi32>
        %f6 = tensor.extract %f[%c6] : tensor<9xi32>
        %f7 = tensor.extract %f[%c7] : tensor<9xi32>
        %f8 = tensor.extract %f[%c8] : tensor<9xi32>

        %m0 = arith.muli %p0, %f0 : i32
        %m1 = arith.muli %p1, %f1 : i32
        %m2 = arith.muli %p2, %f2 : i32
        %m3 = arith.muli %p3, %f3 : i32
        %m4 = arith.muli %p4, %f4 : i32
        %m5 = arith.muli %p5, %f5 : i32
        %m6 = arith.muli %p6, %f6 : i32
        %m7 = arith.muli %p7, %f7 : i32
        %m8 = arith.muli %p8, %f8 : i32

        // Tree reduce: 9 partial products → 1 scalar (8 adds).
        %s01 = arith.addi %m0, %m1 : i32
        %s23 = arith.addi %m2, %m3 : i32
        %s45 = arith.addi %m4, %m5 : i32
        %s67 = arith.addi %m6, %m7 : i32
        %s0123 = arith.addi %s01, %s23 : i32
        %s4567 = arith.addi %s45, %s67 : i32
        %s01234567 = arith.addi %s0123, %s4567 : i32
        %s = arith.addi %s01234567, %m8 : i32

        %init = arith.constant dense<0> : tensor<1xi32>
        %out = tensor.insert %s into %init[%c0] : tensor<1xi32>
        secret.yield %out : tensor<1xi32>
    } -> !outputvec

    return %result : !outputvec
}
